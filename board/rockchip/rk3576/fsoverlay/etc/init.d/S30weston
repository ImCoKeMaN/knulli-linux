#!/bin/sh
#
# Starts Weston
#

start() {
    printf 'Starting Weston'
    weston -B drm &
}

stop() {
    printf 'Stopping Weston'
    killall -9 weston
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start|stop|restart)
        "$1";;
    reload)
        # Restart, since there is no true "reload" feature.
        restart;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}"
        exit 1
esac
