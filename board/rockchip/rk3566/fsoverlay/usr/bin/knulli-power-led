#!/bin/sh

LED_ROOT="/sys/class/leds"
LED_FULL="${LED_ROOT}/battery_full"
LED_CHG="${LED_ROOT}/battery_charging"
LED_LOW="${LED_ROOT}/low_power"

is_discharging() {
    [ "$(knulli-battery-check status 2>/dev/null)" = "Discharging" ]
}

set_on() {
  echo 1 >"$1/brightness" 2>/dev/null;
}

set_off() {
  echo 0 >"$1/brightness" 2>/dev/null;
}

set_critical() {
    if ! is_discharging; then
        exit 0
    fi

    trap 'set_on "$LED_LOW"; exit' INT TERM # Just in case it exits will revert to on

    i=0
    state=0 # 0=off,1=on
    while [ $i -lt 240 ]; do
        # abort if device stops discharging
        if ! is_discharging; then
            break
        fi

        if [ $state -eq 0 ]; then
            set_on "$LED_LOW"; state=1
            else
            set_off "$LED_LOW"; state=0
        fi

        sleep 0.5
        i=$((i+1))
    done

    set_on "$LED_LOW"
}

case "$1" in
  power)
    [ "$2" = "off" ] && set_off "$LED_FULL" || set_on "$LED_FULL"
    ;;
  charging)
    [ "$2" = "off" ] && set_off "$LED_CHG" || set_on "$LED_CHG"
    ;;
  low)
    [ "$2" = "off" ] && set_off "$LED_LOW" || set_on "$LED_LOW"
    ;;
  critical)
    set_critical
    ;;
  *)
    echo "Usage: knulli-power-led full|charging|low [on|off] | critical" ;;

esac
