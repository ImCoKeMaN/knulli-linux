#!/bin/bash

# We only want to run the script if the board has RGB capability
if ! knulli-board-capability "rgb"; then
    exit 1
fi

PERCENTAGE=$(knulli-battery-check capacity)

if [ ! -z "$PERCENTAGE" ]; then
  curl -d "$PERCENTAGE Discharging" -X POST localhost:1235/update-battery-state
fi

exit 0
