#!/bin/sh

# Uses USR1 as a trigger for batteryplus to immediately start a new loop and snap to current battery %

PIDFILE="/var/run/batteryplus.pid"

case "$1" in
  resume|thaw)
    [ -f "$PIDFILE" ] || exit 0
    read -r PID < "$PIDFILE" 2>/dev/null
    [ -n "$PID" ] && kill -USR1 "$PID" 2>/dev/null
    ;;
esac

exit 0
