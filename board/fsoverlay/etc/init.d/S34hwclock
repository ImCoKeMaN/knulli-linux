#!/bin/sh

ADJ_DATA="/boot/boot/adjtime.data"

[ -e /dev/rtc0 ] || [ -e /sys/class/rtc/rtc0 ] || exit 0

ensure_adjtime_utc() {
    # Ensure hwclock treats RTC as UTC (atomic write)
    if [ ! -f "$ADJ_DATA" ]; then
        tmp="$ADJ_DATA.$$"
        printf '0.0 0 0.0\n0\nUTC\n' > "$tmp" && mv -f "$tmp" "$ADJ_DATA" 2>/dev/null
    fi
}

start() {
    if [ -f "$ADJ_DATA" ]; then
        hwclock --hctosys --utc --adjfile "$ADJ_DATA" 2>/dev/null
        echo "Loaded system time from RTC (UTC, adjfile)"
    else
        hwclock --hctosys --utc --noadjfile 2>/dev/null
        echo "Loaded system time from RTC (UTC, noadjfile)"
    fi
}

stop() {
    mount -o remount,rw /boot >/dev/null 2>&1

    ensure_adjtime_utc
    hwclock --systohc --utc --adjfile "$ADJ_DATA" 2>/dev/null
    echo "Saved system time to RTC (UTC, adjfile)"

    mount -o remount,ro /boot >/dev/null 2>&1
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  *) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
