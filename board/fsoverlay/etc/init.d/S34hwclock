#!/bin/sh

has_rtc() {
    [ -e /dev/rtc0 ] || [ -e /sys/class/rtc/rtc0 ]
}

ensure_adjtime_utc() {
    # Ensure hwclock treats RTC as UTC (atomic write)
    if [ ! -f /etc/adjtime ] || ! tail -n1 /etc/adjtime 2>/dev/null | grep -qx UTC; then
        tmp="/etc/adjtime.$$"
        { printf '0.0 0 0.0\n0\nUTC\n' > "$tmp" && mv -f "$tmp" /etc/adjtime; } 2>/dev/null || true
    fi
}

start() {
    ensure_adjtime_utc
    if has_rtc; then
        hwclock --hctosys --utc 2>/dev/null
        echo "Loaded system time from RTC (UTC)"
    else
        echo "No RTC found, skipped"
    fi
}

stop() {
    ensure_adjtime_utc
    if has_rtc; then
        hwclock --systohc --utc 2>/dev/null
        echo "Saved system time to RTC (UTC)"
    else
        echo "No RTC found, skipped"
    fi
}

case "$1" in
  start)   start ;;
  stop)    stop ;;
  *) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
