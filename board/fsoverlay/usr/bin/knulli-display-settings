#!/bin/sh

CT="/sys/class/disp/disp/attr/color_temperature"

TEMP_RANGE=100

is_int() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

clamp_pct() {
    v="$1"
    is_int "$v" || return 1
    [ "$v" -gt 100 ] && v=100
    echo "$v"
}

pct_to_range() {
    pct="$1"
    min="$2"
    max="$3"

    # span = max - min
    span=$((max - min))

    # n = pct * span
    n=$((pct * span))

    # round(n / 100) correctly for negative spans too
    if [ "$n" -ge 0 ]; then
        val=$(((n + 50) / 100))
    else
        val=$(((n - 50) / 100))
    fi

    # shift into range
    echo $((min + val))
}

do_get() {
    [ -f "$CT" ] && echo "temperature"
}

do_set() {
    setting="$1"
    value="$2"

    case "$setting" in
        temperature)
            [ -f "$CT" ] || { echo "Color temperature not available on this device" >&2; exit 1; }

            pct="$(clamp_pct "$value")" || { echo "invalid value" >&2; exit 1; }

            raw="$(pct_to_range "$pct" "-$TEMP_RANGE" "$TEMP_RANGE")"

            echo "$raw" > "$CT" || exit 1
            ;;
        *)
            echo "unknown setting: $setting" >&2
            exit 1
            ;;
    esac
}

case "$1" in
    --get-capabilities)
        do_get
        ;;
    *)
        # ES calls knulli-display-settings <setting> <value>
        [ $# -eq 2 ] || {
            echo "usage: $0 <setting> <value>" >&2
            exit 1
        }
        do_set "$1" "$2"
        ;;
esac

exit 0
