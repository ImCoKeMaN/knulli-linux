#!/bin/sh

# We only want to run the script if the board has hdmi capability
if ! knulli-board-capability "hdmi"; then
    exit 1
fi

read -r ARCH < "/usr/share/knulli/knulli.arch"
HDMI_FILE=""
HDMI_SINK=""
DEVICE_SINK=""

is_fbflush=0
is_suspend=0
is_hdmi=0

case "$ARCH" in
    h700)
        HDMI_FILE="/sys/devices/platform/soc/6000000.hdmi/extcon/hdmi/state"
        HDMI_SINK="alsa_output._sys_devices_platform_soc_soc_03000000_ahub1_mach_sound_card2.stereo-fallback"
        DEVICE_SINK="alsa_output._sys_devices_platform_soc_soc_03000000_codec_mach_sound_card0.stereo-fallback"
        is_fbflush=1
        is_suspend=1
        ;;
    sm8250)
        # TODO: fill in once known
        ;;
    *)
        ;;
esac

check_ingame() {
    HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:1234/runningGame")
    test $? != 0                 && return 0
    test "${HTTP_STATUS}" != 201 && return 0 # in game
    return 1  # 201 when not in game
}

if check_ingame; then
    exit 0 # We don't want emulation station restarting while a emulator is running
fi

curl -s --connect-timeout 2 "http://localhost:1234/quit" > /dev/null # Restarts ES gracefully so we can switch resolution/video output

[ $is_fbflush = 1 ] && fb-flush # Gets rid of artifacts sometimes present when stopping ES before it starts again.

i=0
while pidof emulationstation >/dev/null 2>&1; do
  sleep 0.1
  i=$((i+1))
  [ $i -ge 100 ] && break
done

if [ -n "$HDMI_FILE" ] && [ -r "$HDMI_FILE" ]; then
  read -r HDMI_STATE < "$HDMI_FILE"
  case "$HDMI_STATE" in
    "HDMI=1"|"1"|"connected") is_hdmi=1 ;;
  esac
fi

target_sink="$DEVICE_SINK"
[ $is_hdmi = 1 ] && target_sink="$HDMI_SINK"

if [ $is_hdmi = 1 ]; then
  target_sink="$HDMI_SINK"
else
  [ $is_suspend = 1 ] && knulli-suspend 1
  target_sink="$DEVICE_SINK"
fi

# Apply target sink
if [ -n "$target_sink" ]; then
  knulli-audio set "$target_sink"
fi

exit 0
