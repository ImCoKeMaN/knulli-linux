#!/bin/bash
# Helper for BatteryPlus:
#  - Updates /tmp/battery.status
#  - Runs /etc/batteryplus/state.d/* with the given state argument (second arg -f forces a state change even if it didn't change)
#
# Intended usage (udev):
#   SUBSYSTEM=="power_supply", ACTION=="change", RUN+="/usr/bin/batteryplus-state change"
#
# Hooks:
#   /etc/batteryplus/state.d/*
#     - any executable files here will be called as:
#         hook_path "<state>"
#       where <state> is the first argument passed to this script
#
# Example:
#   batteryplus-state Charging
#   batteryplus-state Discharging
#   batteryplus-state Full

TS_FILE="/tmp/batteryplus-state.ts"
STATUS_FILE="/tmp/battery.status"
HOOK_DIR="/etc/batteryplus/state.d"

IN_STATE="$1"
OUT_STATE=""

# Exit if no arg
[ -z "$IN_STATE" ] && exit 0

normalize_state() {
    case "$1" in
        charging|Charging|CHARGING) echo "Charging" ;;
        discharging|Discharging|DISCHARGING) echo "Discharging" ;;
        full|Full|FULL) echo "Full" ;;
        *) echo "" ;;
    esac
}

change_state() {
    local state="$1"

    if [ "$state" = "change" ]; then
        local raw=""
        for p in /sys/class/power_supply/*{BAT,bat,FUEL,fuel}*/status; do
            [ -f "$p" ] || continue
            read -r raw < "$p" 2>/dev/null || raw=""
            break
        done
        OUT_STATE=$(normalize_state "$raw")
    else
        OUT_STATE=$(normalize_state "$state")
    fi
}

# Accept only real states
case "$IN_STATE" in
    change|[cC]harging|[dD]ischarging|[fF]ull)
        change_state "$IN_STATE"
        ;;
    *)
        exit 0
        ;;
esac

# If no valid state, exit
[ -z "$OUT_STATE" ] && exit 0

# Only write if state actually changed
old_state=""
if [ -f "$STATUS_FILE" ]; then
    read -r old_state < "$STATUS_FILE" 2>/dev/null || old_state=""
fi

if [ -z $2 ] || [ $2 != "-f" ]; then
    if [ "$old_state" = "$OUT_STATE" ]; then
        # No change, don't touch file or run hooks
        exit 0
    fi
fi

# Very short debounce using timestamp since flock does not work with udev rules (they just queue)
now=$(date +%s%3N)  # ms
last_ts=0
if [ -f "$TS_FILE" ]; then
    read -r last_ts < "$TS_FILE" 2>/dev/null || last_ts=0
fi

if [ "$last_ts" -gt 0 ] && [ "$(( now - last_ts ))" -lt 200 ]; then
    echo "$now" >"$TS_FILE"
    exit 0
fi

echo "$OUT_STATE" > "$STATUS_FILE"
echo "$now" >"$TS_FILE"

# Ensure hook directory exists
mkdir -p "$HOOK_DIR"

# Run all hooks in state.d asynchronously passing the state
if [ -d "$HOOK_DIR" ]; then
    for hook in "$HOOK_DIR"/*; do
        [ -f "$hook" ] || continue
        # Run in background
        "$hook" "$OUT_STATE" >/dev/null 2>&1 &
    done
fi

exit 0
