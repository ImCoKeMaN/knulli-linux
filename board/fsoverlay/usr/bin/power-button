#!/bin/bash

LOCK_FILE="/var/run/power-button-script.lock"
POWER_BUTTON_STATE="/var/run/power-button.held"
RESUME_FLAG="/var/run/power-button.wake"

# Threshold for long press to shutdown (in seconds) (some boards cut power when power button is held too long)
LONG_PRESS_THRESHOLD=2

rm -f "$POWER_BUTTON_STATE"

if [ -e "$RESUME_FLAG" ]; then
    rm -f "$RESUME_FLAG"
    exit 0
fi

exec 200>"${LOCK_FILE}"
if ! flock -n 200; then
    exit 0
fi

trap 'flock -u 200;' EXIT

suspend_system() {
    knulli-suspend &
}

shutdown_system() {
    knulli-shutdown -s
}

# Set starting state
: > "$POWER_BUTTON_STATE"

# Wait for deletion of state file
if inotifywait -qq -t "$LONG_PRESS_THRESHOLD" -e delete_self "$POWER_BUTTON_STATE"; then
    # Power button state changed within timeout (short press)
    if [ ! -e "$POWER_BUTTON_STATE" ]; then
        suspend_system
    fi
else
    # Shutdown if timeout is reached (long press)
    if [ -e "$POWER_BUTTON_STATE" ]; then
        # Rumble feedback
        if knulli-board-capability "rumble" >/dev/null 2>&1 && [ -f /usr/bin/knulli-rumble ]; then
            knulli-rumble 0.2 &
        fi

        # Power LED flash
        if knulli-board-capability "pwrled" >/dev/null 2>&1 && [ -f /usr/bin/knulli-power-led ]; then
            knulli-power-led notification &
        fi

        shutdown_system
    fi
fi

exit 0
