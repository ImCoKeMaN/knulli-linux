#!/bin/sh
#
# Bring up the audio DSP before S06audio starts PipeWire.
#
# qcom_q6v5_pas is a MODULE on this board: built in, it probes at ~0.76s and asks
# for /lib/firmware/qcom/sm8550/<vendor>/<device>/adsp.mbn before the rootfs that
# holds it is mounted, gets -2, and never retries -- so ALSA reports "No
# soundcards found".  The firmware cannot go in the initramfs either: this image
# serves ~12 sm8550 devices and each has its own 27MB ADSP blob.
#
# But S06audio runs BEFORE S10udevd, so nothing has loaded the module by the time
# PipeWire and WirePlumber start.  WirePlumber then comes up with no cards and no
# udev daemon to hear the later hotplug from, and settles on a Dummy Output --
# which is exactly what "wpctl status" showed.  Restarting S06audio by hand fixed
# it, which is what identified this as ordering rather than UCM or mixer state.
#
# So load it here, before audio, and wait for the card to actually appear.

CARD=/proc/asound/card0

case "$1" in
    start)
        printf "Starting qcom adsp: "
        modprobe qcom_q6v5_pas >/dev/null 2>&1
        i=0
        while [ "$i" -lt 100 ]; do
            [ -e "$CARD" ] && break
            i=$((i + 1))
            sleep 0.1
        done
        if [ -e "$CARD" ]; then echo "OK"; else echo "no sound card after 10s"; fi
        ;;
    stop|restart|reload)
        ;;
esac

exit 0
