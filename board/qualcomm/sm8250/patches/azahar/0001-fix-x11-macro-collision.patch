 #include <SDL.h>
 #include <SDL_vulkan.h>
 #include <SDL_syswm.h>
+// X11/Xlib.h is pulled in by SDL_syswm.h on toolchains that build SDL2 with
+// X11 support (e.g. sm8250). It defines macros such as None, Bool and Status
+// that collide with identifiers declared inside the Settings namespace.
+#ifdef None
+#undef None
+#endif
+#ifdef Bool
+#undef Bool
+#endif
+#ifdef Status
+#undef Status
+#endif
 #include <fmt/format.h>
