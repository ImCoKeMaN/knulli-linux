+	/* Default to 128 entries if not specified */
+	if (hd->gpt_partition_entries == 0) {
+		hd->gpt_partition_entries = 128;
+	}
 
 	if (hd->align == 0) {
 		hd->align = 512;
@@ -1216,6 +1230,7 @@ static cfg_opt_t hdimage_opts[] = {
 	CFG_BOOL("gpt", cfg_false, CFGF_NODEFAULT),
