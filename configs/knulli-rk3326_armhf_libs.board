include knulli-board.libs
include knulli-rk3326_armhf_libs.packages

# Target definition
BR2_arm=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_cortex_a53=y
BR2_PACKAGE_BATOCERA_TARGET_RK3326=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char -mcpu=cortex-a55 -mtune=cortex-a55"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KNULLI_PATH)/board/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3326/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KNULLI_PATH)/board/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/rockchip/rk3326/fsoverlay"

# Use custom kernel headers from tarball
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_4_4=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL=y
BR2_DEFAULT_KERNEL_HEADERS="4.4.189"
BR2_KERNEL_HEADERS_CUSTOM_TARBALL_LOCATION="$(call github,shantigilbert,hardkernel-linux,d167de7358c9c53d5e6592978f7cdde7674c420b)/d167de7358c9c53d5e6592978f7cdde7674c420b.tar.gz"

# System
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# GPU
BR2_PACKAGE_MALI_G31_GBM=y

# Firmware
BR2_PACKAGE_FIRMWARE_ARMBIAN=y

# Overlay
BR2_PACKAGE_KNULLI_OVERLAY=y
