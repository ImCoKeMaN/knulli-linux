include knulli-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_x3=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_PACKAGE_BATOCERA_TARGET_SM8550=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char -mcpu=cortex-a715+nosve+nosve2"
BR2_TARGET_GENERIC_GETTY_PORT="ttyMSM0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_KNULLI_PATH)/board/patches $(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm8550/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_KNULLI_PATH)/board/fsoverlay $(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm8550/fsoverlay"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.5"
BR2_KERNEL_HEADERS_7_1=y
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm8550/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm8550/linux_sm8550-defconfig.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/qcs8550-retroidpocket-rpnova qcom/qcs8550-retroidpocket-rp6 qcom/qcs8550-retroidpocket-rp6-top-dpad qcom/qcs8550-ayn-odin2 qcom/qcs8550-ayn-odin2portal qcom/qcs8550-ayn-odin2mini qcom/qcs8550-ayn-thor qcom/qcs8550-ayaneo-pocketace qcom/qcs8550-ayaneo-pocketdmg qcom/qcs8550-ayaneo-pocketds qcom/qcs8550-ayaneo-pocketevo qcom/qcs8550-ayaneo-pockets2k"
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_KNULLI_PATH)/board/qualcomm/sm8550/dts/*"

# System
BR2_PACKAGE_BATOCERA_USE_QCOM_FW=y
BR2_PACKAGE_QUALCOMM_FIRMWARE=y
BR2_PACKAGE_FIRMWARE_ARMBIAN=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# GPU
BR2_PACKAGE_BATOCERA_FREEDRENO_MESA3D=y
BR2_PACKAGE_BATOCERA_WAYLAND_LABWC=y
BR2_PACKAGE_BATOCERA_XWAYLAND=y

# Filesystem tools
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# ABL Bootloader
# Boots through rocknix-abl, not GRUB/EFI: create-boot-script.sh gzips the
# kernel, appends every built .dtb and wraps it with mkbootimg.
BR2_PACKAGE_ROCKNIX_ABL=y
BR2_PACKAGE_HOST_PYTHON_MKBOOTIMG=y

# Filesystem
BR2_TARGET_ROOTFS_CPIO_LZ4=y

# Batocera Splash Support
BR2_PACKAGE_BATOCERA_SPLASH_MPV=n

BR2_PACKAGE_XCB_UTIL_KEYSYMS=y

# Libretro cores are NOT compiled by Buildroot.  The gate below turns off every
# "select BR2_PACKAGE_LIBRETRO_*" in knulli-system/Config.in; the cores come
# from the external libretro-super build instead (package/cores/libretro-super).
#
# The DEVICE names which devices/<name>.device file describes this board, and
# that file names the ABI profile it consumes.  sm8550.device points at
# aarch64-v8.2a, the same profile sm8250 uses, so this board reuses that drop
# and pays no core compile of its own.
BR2_PACKAGE_KNULLI_EXTERNAL_LIBRETRO_CORES=y
BR2_PACKAGE_LIBRETRO_SUPER_DEVICE="sm8550"
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_MPV=y

# NO emulators drop for this board.  The drop is keyed on the ABI profile alone,
# and aarch64-v8.2a is harvested from a527 -- a MALI board.  sm8250/sm8550 are
# Adreno/freedreno and ship no libmali at all, so the payload fails the soname
# check on libmali.so.0 (plus ffmpeg/icu drift).  Emulators link the GPU stack,
# so an emulators drop has to be keyed on ABI *and* GPU vendor, the same reason
# knulli-armhf-drop is keyed per board.  Until that exists, build them here.
