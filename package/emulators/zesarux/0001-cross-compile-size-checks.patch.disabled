Bypass compile-and-execute type-size probes that break cross-compilation.
On all supported targets char=1, short=2, int=4, long long int=8.

--- a/src/configure
+++ b/src/configure
@@ -496,8 +496,7 @@ fi
 _EOF
 
-$CCOMPILER $CFLAGS $TEMPFILE -o $TEMPFILE.o >> $LOGFILE 2>&1
-CHARSIZE=`./$TEMPFILE.o`
+CHARSIZE=1
 rm -f $TEMPFILE $TEMPFILE.o
 echo $CHARSIZE
 if [ "$CHARSIZE" != "1" ]; then
@@ -517,8 +516,7 @@ fi
 _EOF
 
-$CCOMPILER $CFLAGS $TEMPFILE -o $TEMPFILE.o >> $LOGFILE 2>&1
-SHORTSIZE=`./$TEMPFILE.o`
+SHORTSIZE=2
 rm -f $TEMPFILE $TEMPFILE.o
 echo $SHORTSIZE
 if [ "$SHORTSIZE" != "2" ]; then
@@ -538,8 +536,7 @@ fi
 _EOF
 
-$CCOMPILER $CFLAGS $TEMPFILE -o $TEMPFILE.o >> $LOGFILE 2>&1
-SHORTSIZE=`./$TEMPFILE.o`
+SHORTSIZE=4
 rm -f $TEMPFILE $TEMPFILE.o
 echo $SHORTSIZE
 if [ "$SHORTSIZE" != "4" ]; then
@@ -559,8 +556,7 @@ fi
 _EOF
 
-$CCOMPILER $CFLAGS $TEMPFILE -o $TEMPFILE.o >> $LOGFILE 2>&1
-SHORTSIZE=`./$TEMPFILE.o`
+SHORTSIZE=8
 rm -f $TEMPFILE $TEMPFILE.o
 echo $SHORTSIZE
 if [ "$SHORTSIZE" != "8" ]; then
