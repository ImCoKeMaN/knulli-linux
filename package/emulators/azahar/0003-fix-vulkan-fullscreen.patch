+void EmuWindow_SDL2_VK::OnResize() {
+    int width = 0, height = 0;
+    SDL_Vulkan_GetDrawableSize(render_window, &width, &height);
+    if (width == 0 || height == 0) {
+        // Fallback: SDL_Vulkan_GetDrawableSize returned 0 (window not yet committed).
+        SDL_GetWindowSize(render_window, &width, &height);
+        LOG_WARNING(Frontend, "VK OnResize: SDL_Vulkan_GetDrawableSize returned 0, "
+                    "falling back to SDL_GetWindowSize = {}x{}", width, height);
+    }
+    if (width <= 0 || height <= 0) {
+        return;
+    }
+
+    // On Wayland with display rotation (e.g. weston.ini transform=rotate-90), the Vulkan WSI
+    // surface uses logical (post-rotation) coordinates while GL/EGL uses physical (pre-rotation)
+    // coordinates. When the logical surface is portrait but the physical display is landscape,
+    // HybridScreen computed for portrait dimensions only fills ~23% of the screen height.
+    // Swap to landscape so the layout matches what the GL renderer produces on this hardware.
+    if (height > width) {
+        LOG_INFO(Frontend,
+                 "VK OnResize: portrait surface {}x{} detected (display rotation); "
+                 "using landscape {}x{} for layout",
+                 width, height, height, width);
+        std::swap(width, height);
+    } else {
+        LOG_INFO(Frontend, "VK OnResize: {}x{}", width, height);
+    }
+
+    UpdateCurrentFramebufferLayout(width, height);
+}
