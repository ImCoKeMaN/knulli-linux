 void EmuWindow_SDL2_GL::Present() {
+    LOG_INFO(Frontend, "SDL2 OpenGL Present() started");
+
+    const bool use_synchronous_rendering = !Settings::values.async_presentation.GetValue();
+    LOG_INFO(Frontend, "Present loop running in {} mode",
+             use_synchronous_rendering ? "synchronous" : "async");
+
+    if (use_synchronous_rendering) {
+        // In synchronous mode, rendering and swapping happens in the emulation thread.
+        // This thread just waits until the window is closed.
+        LOG_INFO(Frontend, "Synchronous mode: Present thread waiting for window close");
+        while (IsOpen()) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        }
+        LOG_INFO(Frontend, "SDL2 OpenGL Present() exited (synchronous mode)");
+        return;
+    }
+
+    // Async mode: original mailbox-based presentation
+    LOG_INFO(Frontend, "Making GL context current...");
     SDL_GL_MakeCurrent(render_window, window_context);
+    LOG_INFO(Frontend, "GL context made current");
+
+    LOG_INFO(Frontend, "Setting swap interval to 1...");
     SDL_GL_SetSwapInterval(1);
+    LOG_INFO(Frontend, "Swap interval set");
+
+    static int frame_count = 0;
     while (IsOpen()) {
+        // Async mode: get frame from mailbox
         system.GPU().Renderer().TryPresent(100, is_secondary);
+
+        // Ensure all framebuffers are unbound before swap
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+
+        // Always flush before swap
+        glFlush();
+
+        if (frame_count == 0) {
+            // Check GL state before first swap
+            GLint draw_fb = 0, read_fb = 0, fb = 0;
+            glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_fb);
+            glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fb);
+            glGetIntegerv(GL_FRAMEBUFFER_BINDING, &fb);
+            GLint viewport[4];
+            glGetIntegerv(GL_VIEWPORT, viewport);
+
+            LOG_INFO(Frontend, "Before first swap: Draw FBO={}, Read FBO={}, FBO={}, Viewport=({},{},{},{})",
+                     draw_fb, read_fb, fb, viewport[0], viewport[1], viewport[2], viewport[3]);
+            LOG_INFO(Frontend, "About to call SDL_GL_SwapWindow for first frame...");
+
+            // Extra finish for first frame debugging
+            glFinish();
+            LOG_INFO(Frontend, "Called glFlush and glFinish");
+        }
+
         SDL_GL_SwapWindow(render_window);
+
+        if (frame_count == 0) {
+            LOG_INFO(Frontend, "First SDL_GL_SwapWindow completed");
+        }
+
+        if (frame_count < 5) {
+            GLint viewport[4];
+            glGetIntegerv(GL_VIEWPORT, viewport);
+            LOG_INFO(Render, "SDL2 Frame {}: GL viewport({},{},{},{})",
+                     frame_count, viewport[0], viewport[1], viewport[2], viewport[3]);
+            frame_count++;
+        }
     }
     SDL_GL_MakeCurrent(render_window, nullptr);
+    LOG_INFO(Frontend, "SDL2 OpenGL Present() exited");
+}
+
+void EmuWindow_SDL2_GL::SwapBuffers() {
+    // This is called from the emulation thread in synchronous rendering mode
+    SDL_GL_SwapWindow(render_window);
 }
