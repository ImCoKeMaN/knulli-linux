config BR2_PACKAGE_MALI_G57_SUNXI
	bool "mali-g57-sunxi"
	depends on BR2_aarch64
	select BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_HAS_LIBMALI
	select BR2_PACKAGE_HAS_LIBOPENCL
	select BR2_PACKAGE_HAS_LIBVULKAN
	
	help
	  Install the binary user-space components for the MALI G57 (VALHALL) SUNXI 
	  GPU.

if BR2_PACKAGE_MALI_G57_SUNXI

config BR2_PACKAGE_PROVIDES_LIBEGL
	default "mali-g57-sunxi"

config BR2_PACKAGE_PROVIDES_LIBGLES
	default "mali-g57-sunxi"

config BR2_PACKAGE_PROVIDES_LIBMALI
	default "mali-g57-sunxi"

config BR2_PACKAGE_PROVIDES_LIBOPENCL
	default "mali-g57-sunxi"

endif

comment "mali-g57-sunxi"
