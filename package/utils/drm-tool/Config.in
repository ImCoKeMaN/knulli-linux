config BR2_PACKAGE_DRM_TOOL
    bool "drm-tool"
    depends on BR2_TOOLCHAIN_HAS_THREADS
    depends on !BR2_STATIC_LIBS
    select BR2_PACKAGE_LIBDRM
    help
      A simple tool for getting drm info and setting properties.
      
      Useful for debugging DRM/KMS display issues and configuring
      display properties from the command line.
      
      https://github.com/NickCis/drm_tool

comment "drm-tool needs a toolchain w/ threads, dynamic library"
    depends on !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
    
