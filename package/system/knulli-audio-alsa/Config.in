config BR2_PACKAGE_KNULLI_AUDIO_ALSA
	bool "knulli-audio"
	select BR2_PACKAGE_BLUEZ_ALSA	if !BR2_PACKAGE_KNULLI_TARGET_SUNXI_R16 && !BR2_PACKAGE_KNULLI_TARGET_ATM7039
	select BR2_PACKAGE_ALSA_UTILS
	select BR2_PACKAGE_ALSA_UTILS_AMIXER
	select BR2_PACKAGE_ALSA_UTILS_APLAY
	select BR2_PACKAGE_ALSA_PLUGINS
	help
	  Audio support and scripts for knulli.linux (ALSA)
