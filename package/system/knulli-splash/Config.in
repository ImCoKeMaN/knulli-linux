config BR2_PACKAGE_KNULLI_SPLASH
    bool "knulli-splash"

    select BR2_PACKAGE_MPV           if BR2_PACKAGE_KNULLI_SPLASH_MPV
    select BR2_PACKAGE_LIBASS        if BR2_PACKAGE_KNULLI_SPLASH_MPV

    help
      Batocera splash

choice
        prompt "splash type"
        default BR2_PACKAGE_KNULLI_SPLASH_IMAGE
        help
          Select knulli.linux splash type

config BR2_PACKAGE_KNULLI_SPLASH_IMAGE
        bool "image"

config BR2_PACKAGE_KNULLI_SPLASH_MPV
        bool "mpv"

endchoice
